{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "prebuild": "npm run typecheck",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "npm run build && wrangler dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:dead": "npx knip",
    "lint:deps": "npx depcheck",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "typecheck:test": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rpc": "vitest run src/services/rpc/__tests__/rpc.integration.test.ts",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "backup": "./scripts/backup.sh",
    "backup:db": "./scripts/backup.sh --db-only",
    "backup:storage": "./scripts/backup.sh --storage-only",
    "db:verify": "psql -d \"$SUPABASE_DB_URL\" -f scripts/ops/verify_consistency.sql",
    "db:verify-rls": "psql -d \"$SUPABASE_DB_URL\" -f scripts/ops/verify_rls.sql",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "e2e": "playwright test",
    "e2e:dev": "playwright test --no-web-server",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@sentry/react": "^10.56.0",
    "@supabase/supabase-js": "^2.106.1",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "^1.168.25",
    "@tanstack/react-start": "^1.168.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.575.0",
    "posthog-js": "^1.383.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vaul": "^1.1.2",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@chromatic-com/storybook": "^5.2.1",
    "@cloudflare/vite-plugin": "^1.39.0",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^10.4.3",
    "@storybook/addon-docs": "^10.4.3",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "^10.4.3",
    "@storybook/tanstack-react": "^10.4.3",
    "@tanstack/router-plugin": "^1.168.11",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "depcheck": "^1.4.7",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-storybook": "^10.4.3",
    "globals": "^15.15.0",
    "happy-dom": "^15.11.7",
    "knip": "^6.16.1",
    "playwright": "^1.60.0",
    "prettier": "^3.7.3",
    "storybook": "^10.4.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vitest": "^3.2.4",
    "wrangler": "^4.95.0"
  }
}
