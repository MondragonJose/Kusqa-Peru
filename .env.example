# Supabase Configuration
# Obtén estas variables de tu proyecto en https://app.supabase.com

# URL de tu proyecto Supabase
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Anon key (pública, safe para usar en frontend)
# Nunca expongas VITE_SUPABASE_SERVICE_ROLE_KEY en el frontend
VITE_SUPABASE_ANON_KEY=sb_publishable_YOUR_ANON_KEY_HERE

# Backup & ops (run via .env.local or export before scripts/backup.sh)
# SUPABASE_PROJECT_REF=your-project-ref
# SUPABASE_DB_PASSWORD=your-db-password
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_DB_URL=postgresql://postgres.REF:password@pooler.supabase.com:5432/postgres

# Live user domain (Auth + profiles + user_progress). Default: mock CURRENT_USER
VITE_USE_LIVE_USER=false

# Atomic join/complete via Supabase RPC (requires migrations through 20260525120100)
VITE_USE_RPC_TRANSACTIONS=false

# Vitest RPC integration (optional — npm run test:rpc)
# SUPABASE_TEST_URL=
# SUPABASE_TEST_ANON_KEY=
# SUPABASE_TEST_EMAIL=
# SUPABASE_TEST_PASSWORD=
# SUPABASE_TEST_MISSION_ID=

# Phase B operational flags
VITE_USE_REALTIME_SYNC=false
VITE_EVIDENCE_UPLOAD_ENABLED=false
VITE_TELEMETRY_ENABLED=false
VITE_USE_INITIATIVE_READ_MODEL=false
VITE_USE_UNIFIED_WRITES=false
VITE_MUNICIPAL_COLLAB=false
# VITE_SENTRY_DSN=
# VITE_POSTHOG_KEY=

# Google Maps API Key (optional)
# Habilita Geocoding, Places Autocomplete y Reverse Geocoding en tiempo real
# Si no está presente, el sistema usa una base de datos local de distritos peruanos
# Obtén tu clave en: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_MAPS_API_KEY=
